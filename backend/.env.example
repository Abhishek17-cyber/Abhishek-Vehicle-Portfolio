# ============================================================
# Abhishek's Vehicle Portfolio — Backend Environment Config
# Copy this file to .env and fill in your actual values.
# ============================================================

# Server Configuration
PORT=3000
NODE_ENV=production

# Database Configuration (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=Abhi@401
DB_NAME=vehicle_portfolio

# JWT Configuration
# Generate a strong random secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_very_strong_jwt_secret_key_here_change_this
JWT_EXPIRES_IN=7d

# Frontend URL (for CORS) — set to your S3 bucket URL after deployment
# Examples:
#   http://your-bucket.s3-website.ap-south-1.amazonaws.com
#   https://yourdomain.com
FRONTEND_URL=http://localhost:5500

# File Upload Configuration
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10
